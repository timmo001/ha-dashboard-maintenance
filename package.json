{
  "name": "dashboard-maintenance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc --noEmit && rolldown -c",
    "lint": "pnpm run build && node --check dist/ha-dashboard-maintenance.js",
    "prepare": "simple-git-hooks",
    "publish-to-local": "bash ./scripts/publish-to-local.sh",
    "start": "rolldown -c --watch",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.12",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2"
  }
}
