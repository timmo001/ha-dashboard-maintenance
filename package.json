{
  "name": "dashboard-maintenance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --noEmit && rolldown -c",
    "lint": "pnpm run build && node --check dist/ha-dashboard-maintenance.js",
    "prepare": "simple-git-hooks",
    "publish-to-local": "bash ./scripts/publish-to-local.sh",
    "start": "rolldown -c --watch",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "rolldown": "1.2.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.0"
  }
}
